{
  "name": "web",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "tags": [
    "runtime:browser"
  ],
  "targets": {
    "dev": {
      "command": "npm run dev",
      "cache": false,
      "continuous": true
    },
    "build": {
      "command": "npm run build",
      "cache": false
    },
    "test": {
      "command": "npm run test",
      "cache": false
    },
    "typecheck": {
      "command": "npm run typecheck",
      "cache": false
    },
    "boundary": {
      "command": "npm run test:boundary",
      "cache": false
    }
  }
}
