{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nature-lens",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nature-lens-transfers",
      "database_id": "6e16a70f-3f01-4d45-9f55-4df7fbab318b",
      "migrations_dir": "worker/migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "BUILD_ID": "RdKuzFpAoPfjuGJsXJs-G"
  }
}
