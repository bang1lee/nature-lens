{
  "name": "nature-lens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-offline.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:production": "node tests/production-smoke.mjs",
    "identify:server": "node server/start.mjs",
    "tauri": "tauri",
    "native:doctor": "tauri info",
    "native:web:dev": "node scripts/native-web.mjs dev",
    "native:web:build": "node scripts/native-web.mjs build",
    "native:mac:dev": "tauri dev",
    "native:mac:build": "tauri build",
    "native:android:init": "tauri android init",
    "native:android:dev": "tauri android dev",
    "native:android:build": "tauri android build",
    "test:app": "playwright test -c app.playwright.config.ts",
    "test:cloud-auth": "playwright test -c tests/cloud-auth.playwright.config.ts",
    "identify:preflight": "node scripts/identify-preflight.mjs",
    "build:cloudflare": "NEXT_PUBLIC_BASE_PATH= npm run build",
    "dev:worker": "wrangler dev --local --test-scheduled",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test:worker": "node tests/worker-smoke.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "test:transfer-live": "node tests/transfer-live.mjs",
    "test:deployed-api": "node tests/deployed-api-smoke.mjs",
    "identify:local": "node server/local-identification.mjs",
    "test:identify:local": "node tests/live-identification.e2e.mjs",
    "deploy:pages": "npm run build:cloudflare && cd deploy/pages && wrangler pages deploy ../../out --project-name nature-lens-mvp --branch main",
    "graph:local": "NX_NO_CLOUD=true NX_DAEMON=false NX_LOAD_DOT_ENV_FILES=false nx graph --print",
    "verify:local": "NX_NO_CLOUD=true NX_DAEMON=false NX_LOAD_DOT_ENV_FILES=false nx run-many -t boundary,typecheck,test --projects=web,worker --parallel=1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "idb": "latest",
    "lucide-react": "latest",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.8",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "0.35.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@babel/parser": "7.29.12",
    "@cloudflare/workers-types": "5.20261007.1",
    "@playwright/test": "latest",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fake-indexeddb": "^6.2.5",
    "nx": "23.3.1",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "4.148.0"
  },
  "type": "module",
  "overrides": {
    "sharp": "$sharp"
  },
  "nx": {
    "includedScripts": []
  }
}
